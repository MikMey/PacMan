{
    // === REQUIRED CONFIG === //
    # Data that has to be present to run

    "highscore_filename": "./data/highscore.json",  // [str] highscore json file location
    "level_count": 5,                               // [int] [>=1] amount of levels

    // === OPTIONAL GLOBAL CONFIG === //
    # Data non-specific to individual levels

    "points": {
        "pacgum": 10,                               // [int] [>=0] (10) points for each pacgum eaten
        "super_pacgum": 50,                         // [int] [>=0] (50) points for each super pacgum eaten
        "ghost": 200                                // [int] [>=0] (200) points for each ghost eaten
    },
    "lives": 3,                                     // [int] [>=1] [<=100] (3) starting lives
    "seed": 67,                                     // [int] [>=0] (67) seed for all (0=random)

    # Fallback for level data if not defined.
    "width": 10,                                    // [int] [>=3] [<=70] (10) default maze width
    "height": 10,                                   // [int] [>=3] [<=70] (10) default maze height
    "pacgums": 0,                                   // [int] [>=0] (0) default pacgum amount per level (0=full)
    "super_pacgums": 4,                             // [int] [>=0] (4) default super pacgum amount per level
    "timer": 90,                                    // [int] [>=1] (90) defaut timer per level in seconds

    // === OPTIONAL LEVEL CONFIG === //
    # Level specific data (last chosen if underdefined, fallback chosen when undefined)

    "levels": [                                     // Any fallback data may be specifically re-set here
        {
            "width": 7,
            "height": 7
        },
        {
            "width": 5,
            "pacgums": 100
        },
        {
            "width": 15,
            "height": 10,
            "timer": 120
        },
        {
            "width": 10,
            "height": 3,
            "pacgums": 30,
            "super_pacgums": 9999,
            "timer": 20
        },
        {
            "width": 70,
            "height": 70,
            "pacgums": 1,
            "super_pacgums": 0,
            "timer": 200
        }
    ]
}